# ── OpenRouter ──────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# ── Firebase ────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=

# ── Branch ──────────────────────────────────────────────
HOUSEPYSBOT_BRANCH_ID=default

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── WhatsApp ────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./wa_session
QR_UI_PORT=3000

# ── Multi-Agent ─────────────────────────────────────────
# Tu chat ID de Telegram (@userinfobot para obtenerlo)
# Los mensajes desde este chat usan el agente Admin (gestión)
# Los demás usuarios usan el agente Atención al Cliente
ADMIN_CHAT_ID=
