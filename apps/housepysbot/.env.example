# ── AI Provider (Groq por defecto) ─────────────────────
OPENAI_API_KEY=gsk_      # https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# ── Firebase ────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=

# ── Branch ──────────────────────────────────────────────
HOUSEPYSBOT_BRANCH_ID=default

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── WhatsApp ────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./wa_session
QR_UI_PORT=3000

# ── Multi-Agent ─────────────────────────────────────────
# Tu chat ID de Telegram (@userinfobot para obtenerlo)
# Los mensajes desde este chat usan el agente Admin (gestión)
# Los demás usuarios usan el agente Atención al Cliente
ADMIN_CHAT_ID=
