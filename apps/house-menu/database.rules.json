{
  "rules": {
    "tenants": {
      "$tenantId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('tenants').child(auth.uid).exists()",
        "sessions": {
          "$token": {
            ".read": "auth.uid === root.child('tenants').child(auth.uid).child('sessions').child($token).child('userId').val()",
            ".write": "auth != null"
          }
        },
        "users": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "memberships": {
          ".read": "auth != null",
          "$mid": {
            ".write": "auth != null"
          }
        },
        "roles": {
          "$roleId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "branches": {
      "$branchId": {
        ".indexOn": ["status", "createdAt", "deliveryDate"],
        "_health": {
          ".write": "auth != null"
        },
        "system": {
          ".read": "auth != null",
          ".write": "auth != null",
          "errors": {
            "$errorId": {
              ".validate": "newData.hasChildren(['agentId', 'message', 'timestamp'])"
            }
          },
          "monitor": {
            "health": {
              ".validate": "newData.hasChildren(['firebase', 'openrouter', 'lastCheck'])"
            }
          },
          "agents": {
            "$agentId": {
              ".validate": "newData.hasChildren(['status', 'lastSeen'])"
            }
          }
        },
        "catalog": {
          ".read": true,
          ".write": "auth != null",
          "products": {
            "$productId": {
              ".validate": "newData.hasChildren(['name', 'base_price']) && newData.child('base_price').isNumber() && newData.child('base_price').val() >= 0"
            }
          }
        },
        "cash_sessions": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "flash_offers_active": {
          ".read": true,
          ".write": "auth != null && root.child('tenants').child(auth.uid).exists()"
        },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('tenants').child(auth.uid).exists()"
        },
        "orders": {
          ".read": "auth != null",
          "$orderId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['status', 'createdAt'])",
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(programado|recibido|preparando|listo|en_camino|entregado|cancelado)$/)"
            },
            "canceledBy": {
              ".validate": "newData.isString()"
            },
            "paidBy": {
              ".validate": "newData.isString()"
            },
            "createdBy": {
              ".validate": "newData.isString()"
            },
            "updatedBy": {
              ".validate": "newData.isString()"
            },
            "editedBy": {
              ".validate": "newData.isString()"
            },
            "notedBy": {
              ".validate": "newData.isString()"
            }
          }
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('tenants').child(auth.uid).exists()",
          "$msgId": {
            ".validate": "newData.hasChildren(['text', 'sender', 'timestamp'])"
          }
        },
        "attendance": {
          ".read": "auth != null",
          "$employeeId": {
            ".write": "auth != null",
            "$date": {
              ".validate": "newData.hasChildren(['employeeId', 'date', 'clockIn'])"
            }
          }
        },
        "delivery": {
          ".read": "auth != null",
          ".write": "auth != null",
          "drivers": {
            "$driverId": {
              ".write": "auth != null"
            }
          }
        },
        "employees": {
          ".read": "auth != null",
          "$employeeId": {
            ".write": "auth != null"
          }
        },
        "fcm_tokens": {
          ".read": "auth != null",
          "$userId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "branches_config": {
      ".read": "auth != null",
      "$branchId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('tenants').child(auth.uid).exists()",
        "fiscal": {
          "$field": {
            ".read": "auth != null && root.child('tenants').child(auth.uid).exists()",
            ".write": "auth != null && root.child('tenants').child(auth.uid).exists()"
          }
        }
      }
    },
    "customers": {
      ".read": "auth != null",
      "$customerId": {
        ".write": "auth != null"
      }
    },
    "chats": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "agent_tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$taskId": {
        ".validate": "newData.hasChildren(['instruccion', 'activa'])"
      }
    },

    "agent_audit": {
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['task_id', 'ejecucion', 'resultado'])"
      }
    }
  }
}
