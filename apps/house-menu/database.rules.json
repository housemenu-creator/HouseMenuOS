{
  "rules": {
    "tenants": {
      "$tenantId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "sessions": {
          "$token": {
            ".read": "auth.uid === root.child('tenants').child($tenantId).child('sessions').child($token).child('userId').val()",
            ".write": "auth != null"
          }
        },
        "employees": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth.uid === $uid || data.child('role').val() === 'admin' || data.child('role').val() === 'superadmin'",
            "profile": {
              ".write": "auth.uid === $uid || root.parent().child('role').val() === 'admin' || root.parent().child('role').val() === 'superadmin'"
            },
            "role": {
              ".write": "root.parent().child('role').val() === 'admin' || root.parent().child('role').val() === 'superadmin'"
            },
            "branches": {
              ".write": "root.parent().child('role').val() === 'admin' || root.parent().child('role').val() === 'superadmin'"
            },
            "firebaseUid": {
              ".write": false
            },
            "attendance": {
              "$date": {
                ".write": "auth.uid === $uid || root.parent().parent().child('role').val() === 'admin' || root.parent().parent().child('role').val() === 'superadmin"
              }
            },
            "schedule": {
              ".write": "root.parent().child('role').val() === 'admin' || root.parent().child('role').val() === 'superadmin'"
            },
            "goals": {
              "$gid": {
                ".write": "root.parent().parent().child('role').val() === 'admin' || root.parent().parent().child('role').val() === 'superadmin"
              }
            }
          }
        },
        "roles": {
          "$roleId": {
            ".read": "auth != null",
            ".write": "root.parent().parent().child('employees').child(auth.uid).child('role').val() === 'admin' || root.parent().parent().child('employees').child(auth.uid).child('role').val() === 'superadmin'"
          }
        },
        "cuentas": {
          ".read": "auth != null",
          "$cuentaId": {
            ".write": "root.parent().parent().child('employees').child(auth.uid).child('role').val() in ['admin', 'superadmin', 'vendedor', 'cajero']"
          }
        }
      }
    },
    "branches": {
      "$branchId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["status", "createdAt", "deliveryDate"],
        "catalog": {
          ".read": true,
          ".write": "auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() in ['admin', 'superadmin', 'vendedor']"
        },
        "config": {
          ".read": "auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() in ['admin', 'superadmin']",
          ".write": "auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() in ['admin', 'superadmin']"
        },
        "cash_sessions": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() in ['admin', 'superadmin', 'cajero']"
        },
        "_role_cache": {
          ".read": false,
          ".write": false,
          "$uid": {
            ".read": "auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() in ['admin', 'superadmin']",
            ".write": "auth.uid === $uid || (auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() in ['admin', 'superadmin'])"
          }
        },
        "orders": {
          ".read": "auth != null",
          "$orderId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['status', 'createdAt'])",
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(programado|recibido|preparando|listo|en_camino|entregado|cancelado)$/)"
            },
            "canceledBy": { ".validate": "newData.isString()" },
            "paidBy": { ".validate": "newData.isString()" },
            "createdBy": { ".validate": "newData.isString()" },
            "updatedBy": { ".validate": "newData.isString()" },
            "editedBy": { ".validate": "newData.isString()" },
            "notedBy": { ".validate": "newData.isString()" }
          }
        },
        "orders_by_session": {
          "$sessionId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$msgId": {
            ".validate": "newData.hasChildren(['text', 'sender', 'timestamp'])"
          }
        },
        "attendance": {
          "$employeeId": {
            ".write": "$employeeId === auth.uid",
            "$date": {
              ".validate": "newData.hasChildren(['employeeId', 'date', 'clockIn'])"
            }
          }
        },
        "fcm_tokens": {
          "$userId": {
            ".write": "$userId === auth.uid"
          }
        },
        "notifications": {
          "$userId": {
            ".write": "$userId === auth.uid"
          }
        },
        "delivery": {
          "drivers": {
            "$driverId": {
              ".write": "$driverId === auth.uid"
            }
          }
        }
      }
    },
    "carts": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "branches_config": {
      ".read": "auth != null",
      "$branchId": {
        ".write": "auth != null"
      }
    },
    "customers": {
      ".read": "auth != null",
      "$customerId": {
        ".write": "auth != null"
      }
    },
    "chats": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "agent_tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$taskId": {
        ".validate": "newData.hasChildren(['instruccion', 'activa'])"
      }
    }
  }
}
