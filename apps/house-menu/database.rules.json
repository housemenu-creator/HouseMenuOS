{
  "rules": {
    "global": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('global/users').child(auth.uid).child('role').val() === 'superadmin')"
        }
      },
      "emails_to_uid": {
        ".read": "auth != null",
        "$email": {
          ".write": "auth != null && (auth.uid === root.child('global/emails_to_uid').child($email).val() || root.child('global/users').child(auth.uid).child('role').val() === 'superadmin')"
        }
      },
      "slugs": {
        ".read": true,
        "$slug": {
          ".write": "auth != null"
        }
      }
    },
    "tenants": {
      ".read": "auth != null",
      "$tenantId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "config": {
          ".read": true
        },
        "sessions": {
          "$token": {
            ".read": "auth.uid === root.child('tenants').child($tenantId).child('sessions').child($token).child('userId').val()",
            ".write": "auth != null"
          }
        },
        "employees": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth.uid === $uid || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'",
            "profile": {
              ".write": "auth.uid === $uid || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
            },
            "role": {
              ".write": "root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
            },
            "branches": {
              ".write": "root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
            },
            "firebaseUid": {
              ".write": "auth.uid === $uid || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
            },
            "attendance": {
              "$date": {
                ".write": "auth.uid === $uid || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
              }
            },
            "schedule": {
              ".write": "root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
            },
            "goals": {
              "$gid": {
                ".write": "root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
              }
            }
          }
        },
        "roles": {
          "$roleId": {
            ".read": "auth != null",
            ".write": "root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin'"
          }
        },
        "cuentas": {
          ".read": "auth != null",
          "$cuentaId": {
            ".write": "root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'admin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'superadmin' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'vendedor' || root.child('tenants').child($tenantId).child('employees').child(auth.uid).child('role').val() === 'cajero'"
          }
        },
        "workflows": {
          "$workflowId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "branches": {
      ".read": "auth != null",
      "$branchId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["status", "createdAt", "deliveryDate"],
        "catalog": {
          ".read": true,
          ".write": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'vendedor')"
        },
        "flash_offers": {
          ".read": true,
          ".write": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin')"
        },
        "flash_offers_active": {
          ".read": true,
          ".write": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin')"
        },
        "config": {
          ".read": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin')",
          ".write": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin')"
        },
        "cash_sessions": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'cajero'"
        },
        "_role_cache": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth.uid === $uid || (auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin'))"
          }
        },
        "orders": {
          ".read": "auth != null",
          ".write": true,
          "$orderId": {
            ".validate": "newData.hasChildren(['status', 'createdAt'])"
          }
        },
        "orders_by_session": {
          ".read": "auth != null",
          "$sessionId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$channel": {
            ".read": "auth != null",
            ".write": "auth != null",
            "$msgId": {
              ".validate": "newData.hasChildren(['text', 'sender', 'timestamp'])",
              "readBy": {
                "$userId": {
                  ".write": "auth != null"
                }
              }
            }
          }
        },
        "attendance": {
          "$employeeId": {
            ".write": "$employeeId === auth.uid || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin'",
            "$date": {
              ".validate": "newData.hasChildren(['clockIn'])"
            }
          }
        },
        "fcm_tokens": {
          "$userId": {
            ".write": "$userId === auth.uid"
          }
        },
        "notifications": {
          "$userId": {
            ".indexOn": "createdAt",
            ".write": "$userId === auth.uid",
            ".read": "auth != null"
          }
        },
        "delivery": {
          "drivers": {
            ".read": "auth != null",
            "$driverId": {
              ".write": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin' || (data.exists() && data.child('userId').val() === auth.uid))"
            }
          }
        }
      }
    },
    "carts": {
      ".read": "auth != null",
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "branches_config": {
      ".read": true,
      "$branchId": {
        ".read": true,
        ".write": "auth != null",
        "fiscal": {
          ".read": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin')",
          ".write": "auth != null && (root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child($branchId).child('_role_cache').child(auth.uid).val() === 'superadmin')"
        }
      }
    },
    "customers": {
      ".read": "auth != null",
      "$customerId": {
        // Legacy push-key records can be written by any auth user.
        // UID-based records are owned by that user.
        // Points mutations use transactions relaying on the rules-auth check.
        ".write": "auth != null && ($customerId === auth.uid || $customerId.length > 20)",
        "fcmTokens": {
          "$deviceId": {
            ".write": "auth != null && $customerId === auth.uid"
          }
        }
      }
    },
    "promotions": {
      ".read": true,
      ".write": "false",
      "$promoId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "chats": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "agent_tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$taskId": {
        ".validate": "newData.hasChildren(['instruccion', 'activa'])"
      }
    },
    "agent_audit": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "_public": {
      ".read": true,
      "has_tenants": {
        ".write": true
      },
      "flagged": {
        ".write": "auth != null"
      }
    },
    "events": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$tenantId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$status": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "suppliers": {
      ".read": "auth != null",
      "$supplierId": {
        ".write": "auth != null && (root.child('branches').child('monteverde').child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child('monteverde').child('_role_cache').child(auth.uid).val() === 'superadmin')"
      }
    },
    "automation": {
      ".read": "auth != null",
      "rules": {
        "$ruleId": {
          ".write": "auth != null && (root.child('branches').child('monteverde').child('_role_cache').child(auth.uid).val() === 'admin' || root.child('branches').child('monteverde').child('_role_cache').child(auth.uid).val() === 'superadmin')"
        }
      }
    },
    "purchaseOrders": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$branchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "admin_audit": {
      ".read": "auth != null",
      "logs": {
        "$date": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "audit": {
      ".read": "auth != null",
      "logs": {
        "$date": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "wa_session": {
      ".read": "auth != null",
      "$branchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
