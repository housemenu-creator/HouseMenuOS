# Firebase Configuration for HouseMenuOS
# Copy to .env and fill in your Firebase project values.
# These values are PUBLIC (embedded in client-side SW) but
# kept out of version control for secrets-management hygiene.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# Voucher OCR (recepción de compras): clave pública de Gemini + flag de rollout gradual
VITE_GEMINI_API_KEY=your-gemini-key
VITE_ENABLE_VOUCHER_OCR=false
