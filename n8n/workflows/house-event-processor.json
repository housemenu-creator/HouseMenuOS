{
    "name": "HOUSE PO Automation",
    "nodes": [
        {
            "parameters": {
                "path": "house-event",
                "httpMethod": "POST",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "webhookId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [250, 300]
        },
        {
            "parameters": {
                "values": {
                    "number": [
                        {
                            "name": "orderQty",
                            "value": "={{ Math.ceil(($json.body.body.payload.minStock - $json.body.body.payload.currentStock) * 1.2) }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
            "name": "Calcular Cantidad",
            "type": "n8n-nodes-base.set",
            "typeVersion": 2,
            "position": [450, 300]
        },
        {
            "parameters": {
                "jsCode": "const input = $input.first().json;\nconst evt = input.body?.body || {};\nconst body = {\n  eventId: evt.eventId,\n  type: evt.type,\n  tenantId: evt.tenantId,\n  branchId: evt.branchId,\n  occurredAt: evt.occurredAt,\n  correlationId: evt.correlationId,\n  orderQty: input.orderQty,\n  payload: evt.payload\n};\nreturn [{ json: { body: JSON.stringify(body) } }];"
            },
            "id": "e5f6a7b8-c9d0-1234-efab-345678901234",
            "name": "Preparar JSON",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [650, 300]
        },
        {
            "parameters": {
                "executeOnce": true,
                "command": "={{ 'node /home/node/.n8n/po-request.js ' + \"'\" + $json.body + \"'\" }}"
            },
            "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
            "name": "Bridge PO",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [850, 300]
        },
        {
            "parameters": {
                "jsCode": "const input = $input.first().json;\nconst raw = input.stdout;\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch(e) { parsed = { error: 'Failed to parse bridge response', raw: raw }; }\nlet bridgeResponse;\ntry {\n  bridgeResponse = typeof parsed.body === 'string' ? JSON.parse(parsed.body) : parsed.body;\n} catch(e) {\n  bridgeResponse = { error: 'Failed to parse bridge body', raw: parsed.body };\n}\nreturn [{ json: {\n  success: parsed.statusCode === 200,\n  statusCode: parsed.statusCode,\n  poId: bridgeResponse?.poId,\n  suggestedQty: bridgeResponse?.suggestedQty,\n  bridgeError: bridgeResponse?.error\n}}];"
            },
            "id": "f6a7b8c9-d0e1-2345-fabc-456789012345",
            "name": "Parse Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [1050, 300]
        },
        {
            "parameters": {
                "respondWith": "firstIncomingItem",
                "options": {}
            },
            "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
            "name": "Responder",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [1250, 300]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [[{"node": "Calcular Cantidad", "type": "main", "index": 0}]]
        },
        "Calcular Cantidad": {
            "main": [[{"node": "Preparar JSON", "type": "main", "index": 0}]]
        },
        "Preparar JSON": {
            "main": [[{"node": "Bridge PO", "type": "main", "index": 0}]]
        },
        "Bridge PO": {
            "main": [[{"node": "Parse Response", "type": "main", "index": 0}]]
        },
        "Parse Response": {
            "main": [[{"node": "Responder", "type": "main", "index": 0}]]
        }
    },
    "active": true,
    "settings": {"executionOrder": "v1"},
    "staticData": "{}",
    "tags": []
}
