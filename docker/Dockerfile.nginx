# ── Nginx — serves React SPA builds + reverse proxy ──
# Uses multi-stage build to compile React apps first

FROM node:22-alpine AS builder
WORKDIR /app

# 1. Dependencies
COPY package.json package-lock.json ./
COPY apps/house-menu/package.json ./apps/house-menu/
COPY apps/portal-hub/package.json ./apps/portal-hub/
COPY packages/tokens/package.json ./packages/tokens/
COPY packages/db/package.json ./packages/db/
COPY packages/store/package.json ./packages/store/
COPY packages/ui/package.json ./packages/ui/

RUN npm ci --ignore-scripts --omit=optional

# 2. Source code (only active SPAs)
COPY tsconfig.base.json ./
COPY apps/house-menu/ ./apps/house-menu/
COPY apps/portal-hub/ ./apps/portal-hub/
COPY packages/ ./packages/

# 3. Build all React SPAs
RUN npm run build -w apps/house-menu 2>/dev/null || echo "house-menu build skipped"
RUN npm run build -w apps/portal-hub 2>/dev/null || echo "portal-hub build skipped"

# 4. Collect builds
RUN mkdir -p /builds && \
    cp -r apps/house-menu/dist /builds/menu-app 2>/dev/null; \
    cp -r apps/portal-hub/dist /builds/portal-hub 2>/dev/null || true

# ── Runtime ────────────────────────────────────────────
FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /builds /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1
