# Firebase (Vite apps usan VITE_*; Node.js backend usa FIREBASE_* con fallback a VITE_*)
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=house-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=house-portal
VITE_FIREBASE_STORAGE_BUCKET=house-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# Para Node.js backend (housepysbot) — opcional si ya tienes VITE_*
FIREBASE_API_KEY=tu_api_key_aqui
FIREBASE_AUTH_DOMAIN=house-portal.firebaseapp.com
FIREBASE_DATABASE_URL=https://house-portal-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=house-portal
