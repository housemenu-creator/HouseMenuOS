# ── House Portal OS — Environment Variables ──────────────
# Copy this to .env and fill in your values
# cp .env.example .env

# ── HousePySbot HTTP Server ──────────────────────────────
HTTP_PORT=3000
HOUSEPYSBOT_BRANCH_ID=castilla
HOST=http://localhost:3000

# ── Firebase ─────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=house-menuapp

# ── OpenRouter (AI Agent) ────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-flash
OPENROUTER_FALLBACK=openrouter/auto

# ── WhatsApp ─────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./wa_session
WHATSAPP_MAX_CONCURRENCY=3

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
ADMIN_PHONE=
COCINA_CHAT_IDS=
COCINA_PHONES=

# ── Delivery Webhooks ────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=

# ── API Security ─────────────────────────────────────────
API_SECRET_KEY=

# ── Vite Builds (React SPAs) ─────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=house-menuapp
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
